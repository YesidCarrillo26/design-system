{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build-storybook": {
      "dependsOn": [
        "@chroma-yesid/tokens#build",
        "^build"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "storybook": {
      "dependsOn": [
        "@chroma-yesid/tokens#build"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "@chroma-yesid/tokens#build"
      ],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "@chroma-yesid/tokens#build",
        "^build"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@chroma-yesid/tokens#build"
      ]
    },
    "test:storybook": {
      "dependsOn": [
        "@chroma-yesid/tokens#build",
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:native": {
      "dependsOn": [
        "@chroma-yesid/tokens#build",
        "^build"
      ]
    }
  }
}
