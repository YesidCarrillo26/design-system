{
  "name": "@yesid/ui",
  "version": "0.0.0",
  "description": "Componentes del design system para web (React DOM) y native (React Native)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./package.json": "./package.json",
    "./web.css": "./styles/web.css",
    "./native.css": "./styles/native.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@yesid/tokens": "workspace:*",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "@yesid/tsconfig": "workspace:*",
    "publint": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "storybook": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "uniwind": "catalog:"
  },
  "files": [
    "dist",
    "styles",
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YesidCarrillo26/design-system.git",
    "directory": "packages/ui"
  },
  "license": "MIT"
}
