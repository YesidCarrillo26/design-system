{
  "name": "@chroma-yesid/ui",
  "version": "0.3.1",
  "description": "Componentes del design system para web (React DOM) y native (React Native)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./package.json": "./package.json",
    "./web.css": "./styles/web.css",
    "./native.css": "./styles/native.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "check:peers": "node scripts/check-peers.mjs",
    "size": "size-limit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@chroma-yesid/tokens": "workspace:*",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-native": ">=0.88.0 <1",
    "react-native-svg": ">=15.0.0 <16"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "@chroma-yesid/tsconfig": "workspace:*",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "storybook": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "uniwind": "catalog:",
    "react-native-svg": "catalog:"
  },
  "files": [
    "dist",
    "styles",
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YesidCarrillo26/design-system.git",
    "directory": "packages/ui"
  },
  "license": "MIT"
}
