{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // DOM solo por los tipos de Storybook (HTMLElement). Las reglas de oxlint prohíben
    // usar window/document en archivos *.native.*.
    "lib": ["ES2023", "DOM"],
    "moduleSuffixes": [".native", ""],
    "customConditions": ["react-native"]
  }
}
