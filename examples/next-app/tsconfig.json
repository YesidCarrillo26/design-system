{
  "extends": "@chroma-yesid/tsconfig/web.json",
  "compilerOptions": {
    "types": ["node"],
    "moduleSuffixes": [""],
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "incremental": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
